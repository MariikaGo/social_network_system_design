Table users {
  id bigint [pk]
  name varchar
  description text
  photo_id bigint [ref: > media.id]
  city varchar
}

Table interests {
  id bigint [pk]
  name varchar
}

Table user_interests {
  user_id bigint [ref: > users.id]
  interest_id bigint [ref: > interests.id]

  indexes {
    (user_id, interest_id) [pk]
  }
}

Table posts {
  id bigint [pk]
  author_id bigint [not null, ref: > users.id]
  description text
  views_count int [not null, default: 0]
  created_at timestamp [not null]
}

Table comments {
  id bigint [pk]
  post_id bigint [not null, ref: > posts.id]
  author_id bigint [not null, ref: > users.id]
  text text [not null]
  created_at timestamp [not null]
}

Table post_likes {
  post_id bigint [not null, ref: > posts.id]
  user_id bigint [not null, ref: > users.id]
  created_at timestamp [not null]

  indexes {
    (post_id, user_id) [pk]
  }
}

Table hashtags {
  id bigint [pk]
  name varchar [not null, unique]
}

Table post_hashtags {
  post_id bigint [not null, ref: > posts.id]
  hashtag_id bigint [not null, ref: > hashtags.id]

  indexes {
    (post_id, hashtag_id) [pk]
  }
}

Table chats {
  id bigint [pk]
  title varchar
  created_at timestamp
}

Table messages {
  id bigint [pk]
  chat_id bigint [not null, ref: > chats.id]
  sender_id bigint [not null, ref: > users.id]
  text text
  created_at timestamp
}

Table chat_participants {
  chat_id bigint [not null, ref: > chats.id]
  user_id bigint [not null, ref: > users.id]
  joined_at timestamp [not null]

  indexes {
    (chat_id, user_id) [pk]
  }
}

// Статусы прочтения сообщений

Table message_reads {
  message_id bigint [not null, ref: > messages.id]
  user_id bigint [not null, ref: > users.id]
  read_at timestamp [not null]

  indexes {
    (message_id, user_id) [pk]
  }
}


// Отношения между пользователями

Table relationships {
  id bigint [pk]
  user_id bigint [not null, ref: > users.id]
  related_user_id bigint [not null, ref: > users.id]
  type varchar [not null]
  created_at timestamp [not null]

  indexes {
    (user_id, related_user_id, type) [unique]
  }
}


// Медиафайлы

Table media {
  id bigint [pk]
  owner_id bigint [not null, ref: > users.id]
  type varchar [not null]
  url varchar [not null]
  created_at timestamp [not null]
}


// Связь постов и медиафайлов

Table post_media {
  post_id bigint [not null, ref: > posts.id]
  media_id bigint [not null, ref: > media.id]

  indexes {
    (post_id, media_id) [pk]
  }
}
